def app_icon() -> QIcon:
    """Theme's OneDrive icon if present, otherwise our own built-in icon."""
    if QIcon.hasThemeIcon("onedrive"):
        return QIcon.fromTheme("onedrive")
    icon = QIcon()
    for size in (16, 22, 24, 32, 48, 64, 128):
        pm = QPixmap()
        if pm.loadFromData(APP_SVG, "SVG"):
            icon.addPixmap(pm.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio,
                                     Qt.TransformationMode.SmoothTransformation))
    return icon if not icon.isNull() else QIcon.fromTheme(APP_ID, QIcon.fromTheme("folder-cloud"))


def warning_icon() -> QIcon:
    return QIcon.fromTheme("data-warning", QIcon.fromTheme("dialog-warning"))


def as_pixmaps(icon: QIcon) -> QIcon:
    """Copy of the icon without a theme name, so the tray gets real images.
    Otherwise Qt only sends the icon *name*, and Plasma can't always resolve
    it (e.g. icons in ~/.local/share/icons), which leaves an invisible item."""
    out = QIcon()
    for size in (16, 22, 24, 32, 48, 64):
        out.addPixmap(icon.pixmap(size, size))
    return out


