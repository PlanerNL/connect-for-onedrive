def migrate_legacy_settings():
    """Take over the settings of an earlier app name (once)."""
    if SETTINGS_FILE.exists():
        return
    for old in LEGACY_IDS:
        old_file = CONFIG_DIR.parent / old / "settings.json"
        if old_file.exists():
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            shutil.copy2(old_file, SETTINGS_FILE)
            return


def migrate_legacy_autostart():
    """Replace the autostart entry of an earlier app name with ours."""
    found = False
    for old in LEGACY_IDS:
        old_file = AUTOSTART.parent / f"{old}.desktop"
        if old_file.exists():
            old_file.unlink()
            found = True
    if found:
        set_autostart(True)


def load_settings() -> dict:
    try:
        return json.loads(SETTINGS_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_settings(settings: dict):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(json.dumps(settings, indent=2))


migrate_legacy_settings()
