def systemctl(*args, check=False):
    return run("systemctl", "--user", *args, check=check)


def service_active() -> bool:
    return systemctl("is-active", SERVICE).stdout.strip() == "active"


def install_service():
    SERVICE_PATH.parent.mkdir(parents=True, exist_ok=True)
    SERVICE_PATH.write_text(SERVICE_TEMPLATE.format(
        mount=MOUNT_DIR, remote=REMOTE, cache=CACHE_SIZE, mkdir=shutil.which("mkdir"),
        rclone=shutil.which("rclone"), fusermount=shutil.which("fusermount3")))
    systemctl("daemon-reload", check=True)
    systemctl("enable", "--now", SERVICE, check=True)


def remove_service():
    systemctl("disable", "--now", SERVICE)
    SERVICE_PATH.unlink(missing_ok=True)
    systemctl("daemon-reload")


# ------------------------------------------------------------------ sidebar
def is_kde() -> bool:
    return "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper()


XBEL_NS = 'xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"'
XBEL_EMPTY = (f'<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n'
              f'<xbel {XBEL_NS}>\n</xbel>\n')


def place_icon() -> str:
    # Only real theme icons: file managers don't always find icons in ~/.local
    return "onedrive" if QIcon.hasThemeIcon("onedrive") else "folder-cloud"


def add_kde_place():
    url = MOUNT_DIR.as_uri()
    text = PLACES.read_text() if PLACES.exists() else XBEL_EMPTY
    if f'href="{url}"' in text:
        return
    if "xmlns:bookmark=" not in text:
        text = text.replace("<xbel", f"<xbel {XBEL_NS}", 1)
    head, sep, tail = text.rpartition("</xbel>")
    if not sep:
        raise RuntimeError(t("err_xbel", path=PLACES))
    entry = (f' <bookmark href="{url}">\n'
             f'  <title>OneDrive</title>\n'
             f'  <info>\n'
             f'   <metadata owner="http://freedesktop.org">\n'
             f'    <bookmark:icon name="{place_icon()}"/>\n'
             f'   </metadata>\n'
             f'   <metadata owner="http://www.kde.org">\n'
             f'    <ID>{int(time.time())}/0</ID>\n'
             f'   </metadata>\n'
             f'  </info>\n'
             f' </bookmark>\n')
    PLACES.parent.mkdir(parents=True, exist_ok=True)
    PLACES.write_text(head + entry + sep + tail)


def remove_kde_place():
    if not PLACES.exists():
        return
    url = re.escape(MOUNT_DIR.as_uri())
    text = re.sub(rf'\s*<bookmark href="{url}">.*?</bookmark>', "",
                  PLACES.read_text(), flags=re.S)
    PLACES.write_text(text)


def add_gtk_bookmark():
    """Nautilus, Nemo, Thunar, Caja and GTK file dialogs."""
    if is_kde() and not GTK_BOOKMARKS.exists():
        return
    url = MOUNT_DIR.as_uri()
    lines = GTK_BOOKMARKS.read_text().splitlines() if GTK_BOOKMARKS.exists() else []
    if any(line.split(" ", 1)[0] == url for line in lines):
        return
    GTK_BOOKMARKS.parent.mkdir(parents=True, exist_ok=True)
    GTK_BOOKMARKS.write_text("\n".join(lines + [f"{url} OneDrive"]) + "\n")


def remove_gtk_bookmark():
    if not GTK_BOOKMARKS.exists():
        return
    url = MOUNT_DIR.as_uri()
    lines = [line for line in GTK_BOOKMARKS.read_text().splitlines()
             if line.split(" ", 1)[0] != url]
    GTK_BOOKMARKS.write_text("\n".join(lines) + ("\n" if lines else ""))


def add_places():
    if is_kde() or PLACES.exists():
        add_kde_place()
    add_gtk_bookmark()


def remove_places():
    remove_kde_place()
    remove_gtk_bookmark()


