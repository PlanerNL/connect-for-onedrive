        layout.addLayout(buttons)

        self.build_tray()
        self.retranslate()

        self.login_timer = QTimer(self)
        self.login_timer.timeout.connect(self.check_login)
        self.login_timer.start(CHECK_INTERVAL_MS)
        self.status_timer = QTimer(self)
        self.status_timer.timeout.connect(self.refresh)
        self.status_timer.start(STATUS_INTERVAL_MS)

        QTimer.singleShot(300, self.check_login)

    # ----------------------------------------------------------- language
    def set_language(self, code: str):
        global LANG
        if code not in STRINGS or code == LANG:
            return
        LANG = code
        settings = load_settings()
        settings["language"] = code
        save_settings(settings)
        self.retranslate()

    def retranslate(self):
        self.setWindowTitle(APP_NAME)
        self.btn_connect.setText(t("connect"))
        self.btn_open.setText(t("open_folder"))
        self.btn_relogin.setText(t("sign_in_again"))
        self.btn_disconnect.setText(t("disconnect"))
        self.btn_cancel.setText(t("cancel"))

        self.act_open.setText(t("tray_open"))
        self.act_web.setText(t("tray_web"))
        self.act_check.setText(t("tray_check"))
        self.act_restart.setText(t("tray_restart"))
        self.act_relogin.setText(t("sign_in_again"))
        self.act_show.setText(t("tray_show"))
        self.act_autostart.setText(t("tray_autostart"))
        self.lang_menu.setTitle(t("tray_language"))
        self.act_quit.setText(t("tray_quit"))

        # keep the combo box and the tray menu in sync
        self.lang_box.blockSignals(True)
        self.lang_box.setCurrentIndex(self.lang_box.findData(LANG))
        self.lang_box.blockSignals(False)
        self.lang_actions[LANG].setChecked(True)
        self.refresh()

    # --------------------------------------------------------- system tray
    def build_tray(self):
        self.tray_icons = {False: as_pixmaps(app_icon()), True: as_pixmaps(warning_icon())}
        self.tray_problem = False
        self.tray = QSystemTrayIcon(self.tray_icons[False], self)
        menu = QMenu(self)

        self.act_status = QAction("…", self)
        self.act_status.setEnabled(False)
        self.act_open = QAction(QIcon.fromTheme("folder-open"), "", self)
        self.act_web = QAction(QIcon.fromTheme("internet-web-browser"), "", self)
        self.act_check = QAction(QIcon.fromTheme("view-refresh"), "", self)
        self.act_restart = QAction(QIcon.fromTheme("system-reboot"), "", self)
        self.act_relogin = QAction(QIcon.fromTheme("dialog-password"), "", self)
        self.act_show = QAction(QIcon.fromTheme("configure"), "", self)
        self.act_autostart = QAction("", self)
        self.act_autostart.setCheckable(True)
        self.act_autostart.setChecked(autostart_enabled())
        self.act_quit = QAction(QIcon.fromTheme("application-exit"), "", self)

        self.lang_menu = QMenu(menu)
        self.lang_menu.setIcon(QIcon.fromTheme("preferences-desktop-locale"))
        group = QActionGroup(self)
        self.lang_actions = {}
        for code, name in LANGUAGES.items():
            act = QAction(name, self, checkable=True)
            act.triggered.connect(lambda _=False, c=code: self.set_language(c))
            group.addAction(act)
            self.lang_menu.addAction(act)
            self.lang_actions[code] = act

        self.act_open.triggered.connect(open_folder)
        self.act_web.triggered.connect(lambda: QDesktopServices.openUrl(QUrl(WEB_URL)))
        self.act_check.triggered.connect(lambda: (self.refresh(), self.check_login()))
        self.act_restart.triggered.connect(self.on_restart_mount)
        self.act_relogin.triggered.connect(self.on_relogin)
        self.act_show.triggered.connect(self.show_window)
        self.act_autostart.toggled.connect(set_autostart)
        self.act_quit.triggered.connect(self.quit_app)

        menu.addAction(self.act_status)
        menu.addSeparator()
        for a in (self.act_open, self.act_web):
            menu.addAction(a)
        menu.addSeparator()
        for a in (self.act_check, self.act_restart, self.act_relogin):
            menu.addAction(a)
        menu.addSeparator()
        menu.addAction(self.act_show)
        menu.addAction(self.act_autostart)
        menu.addMenu(self.lang_menu)
        menu.addSeparator()
        menu.addAction(self.act_quit)

        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self.on_tray_click)
        self.ensure_tray()

    def ensure_tray(self, tries: int = 0):
        """At autostart the system tray may not be ready yet: wait a bit."""
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.tray.show()
        elif tries < 30:
            QTimer.singleShot(1000, lambda: self.ensure_tray(tries + 1))
        else:
            self.show_window()

    def on_tray_click(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            if os.path.ismount(MOUNT_DIR):
                open_folder()
            else:
                self.show_window()

    def notify(self, text: str, warning: bool = False):
        if self.tray.isVisible():
            self.tray.showMessage("OneDrive", text, self.tray_icons[warning], 8000)

    def show_window(self):
        self.refresh()
        self.showNormal()
        self.raise_()
        self.activateWindow()

    # -------------------------------------------------------------- status
    def refresh(self):
        busy = self.proc is not None or bool(self.busy_key)
        deps = missing_deps()
        has_remote = not deps and remote_exists()
        mounted = os.path.ismount(MOUNT_DIR)
        active = not deps and service_active()

        if self.busy_key:
            state, text = "busy", t(self.busy_key)
        elif deps:
            state, text = "deps", t("long_deps", deps=", ".join(deps))
        elif not has_remote:
            state, text = "none", t("long_none")
        elif self.alert == "login":
            state, text = "login", t("long_login")
        elif active and mounted:
            if self.alert == "offline":
                state, text = "offline", t("long_offline")
            else:
                state, text = "ok", t("long_ok", path=MOUNT_DIR)
        elif mounted:
            state, text = "conflict", t("long_conflict")
        else:
            state, text = "unmounted", t("long_unmounted")

        short = t(f"short_{state}")
        if state == "ok" and self.storage:
            usage = t("usage", used=self.storage[0], total=self.storage[1])
            short += f" · {usage}"
            text += f"<br>{usage}."

        # window
        self.status.setText(text)
        self.btn_connect.setVisible(not busy and not (active and mounted))
        self.btn_connect.setEnabled(not deps)
        self.btn_open.setVisible(not busy and active and mounted)
        self.btn_relogin.setVisible(not busy and has_remote)
        self.btn_disconnect.setVisible(not busy and (has_remote or SERVICE_PATH.exists()))
        self.btn_cancel.setVisible(self.proc is not None)

        # system tray
        problem = state in PROBLEM_STATES
        if problem != self.tray_problem:
            self.tray.setIcon(self.tray_icons[problem])
            self.tray_problem = problem
        self.tray.setToolTip(t("tooltip", status=short))
        self.act_status.setText(("⚠️ " if problem else "") + short)
        self.act_open.setEnabled(mounted)
        self.act_check.setEnabled(has_remote and not busy)
        self.act_restart.setEnabled(SERVICE_PATH.exists() and not busy)
        self.act_relogin.setEnabled(has_remote and not busy)

        # only notify once a problem has been seen twice in a row
        if problem:
            if state == self.state and self.notified != state:
                self.notify(t(f"notif_{state}"), warning=True)
                self.notified = state
        else:
            self.notified = None
        self.state = state

    def set_busy(self, key: str):
        self.busy_key = key
        self.refresh()
        QApplication.processEvents()

    def error(self, title: str, details: str):
        QMessageBox.critical(self, title, details.strip() or title)

    # ------------------------------------------------------------- connect
    def on_connect(self):
        mounted = os.path.ismount(MOUNT_DIR)
        if mounted and not service_active():
            return self.error(t("err_in_use_title"), t("err_in_use"))
        if not mounted and MOUNT_DIR.is_dir() and any(MOUNT_DIR.iterdir()):
            return self.error(t("err_not_empty_title"), t("err_not_empty"))
        if remote_exists():
            self.finish_setup()
        else:
            self.start_login(self.finish_setup)

    def finish_setup(self):
        self.set_busy("busy_mount")
        try:
            install_service()
        except subprocess.CalledProcessError as e:
            self.busy_key = ""
            self.refresh()
            log = run("journalctl", "--user", "-u", SERVICE, "-n", "15",
                      "--no-pager").stdout
            return self.error(t("err_mount_title"), f"{e.stderr}\n{log}")
        self.busy_key = ""
        self.update_places(add_places, reopen=str(MOUNT_DIR))
        self.act_autostart.setChecked(True)   # tray icon at every login
        self.refresh()
        self.check_login()

    def on_restart_mount(self):
        self.set_busy("busy_restart")
        result = systemctl("restart", SERVICE)
        self.busy_key = ""
        self.refresh()
        if result.returncode != 0:
            self.notify(t("notif_restart_failed"), warning=True)
        else:
            self.check_login()

    # ------------------------------------------------------------- sign in
    def start_login(self, then):
        self.after_login = then
        self.output = ""
        self.cancelled = False
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.read_output)
        self.proc.finished.connect(self.login_finished)
        self.proc.start(shutil.which("rclone"), ["authorize", "onedrive"])
        self.busy_key = "busy_browser"
        self.refresh()
        if not self.isVisible():
            self.notify(t("notif_browser"))

    def read_output(self):
        self.output += bytes(self.proc.readAllStandardOutput()).decode(errors="replace")

    def on_cancel(self):
        if self.proc:
            self.cancelled = True
            self.proc.kill()

    def login_finished(self, code, _status):
        proc, self.proc = self.proc, None
        proc.deleteLater()
        self.busy_key = ""
        if self.cancelled:
            self.resume_service()
            return self.refresh()
        try:
            if code != 0:
                raise RuntimeError(self.output.strip()[-800:] or t("err_rclone_stopped"))
            token = parse_token(self.output)
            drive_id, drive_type = fetch_drive(token["access_token"])
            write_remote(token, drive_id, drive_type)
        except Exception as e:
            self.resume_service()
            self.refresh()
            return self.error(t("err_login_title"), str(e))
        self.alert = ""
        then, self.after_login = self.after_login, None
        then()
        if not self.isVisible():
            self.notify(t("notif_signed_in"))

    def resume_service(self):
        if SERVICE_PATH.exists():
            systemctl("start", SERVICE)

    def on_relogin(self):
        systemctl("stop", SERVICE)   # prevents rclone writing the config at the same time

        def done():
            self.resume_service()
            self.refresh()
            self.check_login()

        self.start_login(done)

    # ------------------------------------------------------- sign-in check
    def check_login(self):
        if self.proc or missing_deps() or not remote_exists():
            return
        p = QProcess(self)
        p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        p.finished.connect(lambda code, _s: self.login_checked(p, code))
        p.start(shutil.which("rclone"), ["about", f"{REMOTE}:", "--json",
                                         "--contimeout", "15s", "--timeout", "30s"])

    def login_checked(self, p: QProcess, code: int):
        out = bytes(p.readAll()).decode(errors="replace")
        p.deleteLater()
        if code == 0:
            self.alert = ""
            try:
                info = json.loads(out[out.index("{"):])
                self.storage = (human(info["used"]), human(info["total"]))
            except (ValueError, KeyError):
                self.storage = None
        elif any(e in out.lower() for e in AUTH_ERRORS):
            self.alert = "login"
        else:
            self.alert = "offline"
        self.refresh()

    # --------------------------------------------------------------- other
    def update_places(self, change, reopen: str | None = None):
        restart = False
        if dolphin_running():
            answer = QMessageBox.question(self, t("dolphin_title"), t("dolphin_text"))
            restart = answer == QMessageBox.StandardButton.Yes
            if restart:
                run("pkill", "-x", "dolphin")
                for _ in range(50):
                    if not dolphin_running():
                        break
                    time.sleep(0.1)
        try:
            change()
        except Exception as e:
            self.error(t("err_places_title"), str(e))
        if restart:
            args = ["dolphin"] + ([reopen] if reopen else [])
            subprocess.Popen(args, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_disconnect(self):
        box = QMessageBox(self)
        box.setWindowTitle(t("disc_title"))
        box.setText(t("disc_text"))
        box.setInformativeText(t("disc_info"))
        keep = box.addButton(t("disconnect"), QMessageBox.ButtonRole.AcceptRole)
        full = box.addButton(t("disc_full"), QMessageBox.ButtonRole.DestructiveRole)
        cancel = box.addButton(t("cancel"), QMessageBox.ButtonRole.RejectRole)
        box.setDefaultButton(cancel)
        box.exec()
        choice = box.clickedButton()
        if choice not in (keep, full):
            return
        self.set_busy("busy_disconnect")
        remove_service()
        self.busy_key = ""
        self.update_places(remove_places)
        self.act_autostart.setChecked(False)
        if choice is full:
            run("rclone", "config", "delete", REMOTE)
        self.storage = None
        self.alert = ""
        self.refresh()

    def quit_app(self):
        self.quitting = True
        if self.proc:
            self.on_cancel()
            self.proc.waitForFinished(2000)
        self.tray.hide()
        QApplication.quit()

    def closeEvent(self, event):
        # Closing the window = hiding it; the app keeps running in the tray.
        if not self.quitting and self.tray.isVisible():
            event.ignore()
            self.hide()
            if not self.hint_shown:
                self.notify(t("notif_tray_hint"))
                self.hint_shown = True
            return
        super().closeEvent(event)
        self.quit_app()


def cleanup():
    """Remove everything the app created outside rclone.conf."""
    remove_service()
    remove_places()
    set_autostart(False)
    for old in LEGACY_IDS:
        (AUTOSTART.parent / f"{old}.desktop").unlink(missing_ok=True)
    print(t("cleanup_done", remote=REMOTE))


def main():
    if "--cleanup" in sys.argv:
        return cleanup()
    tray_mode = "--tray" in sys.argv
    signal.signal(signal.SIGINT, signal.SIG_DFL)   # Ctrl+C stops the app in a terminal
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setDesktopFileName(APP_ID)
    app.setQuitOnLastWindowClosed(False)

    # Only one instance: a second start shows the existing window.
    sock = QLocalSocket()
    sock.connectToServer(SOCKET_NAME)
    if sock.waitForConnected(300):
        if not tray_mode:
            sock.write(b"show")
            sock.flush()
            sock.waitForBytesWritten(300)
        sock.disconnectFromServer()
        return
    QLocalServer.removeServer(SOCKET_NAME)
    server = QLocalServer()
    server.listen(SOCKET_NAME)

    migrate_legacy_autostart()   # from earlier app names

    win = Window()

    def on_connection():
        conn = server.nextPendingConnection()
        conn.readyRead.connect(
            lambda: win.show_window() if bytes(conn.readAll()).startswith(b"show") else None)
        conn.disconnected.connect(conn.deleteLater)

    server.newConnection.connect(on_connection)

    if not tray_mode:
        win.show_window()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
