def t(key: str, **kw) -> str:
    """Translated text for the current language (English as fallback)."""
    text = STRINGS[LANG].get(key) or STRINGS["en"][key]
    return text.format(**kw) if kw else text


# ------------------------------------------------------------------ helpers
def run(*cmd, check=False):
    """Run a command that can never get stuck waiting for input."""
    return subprocess.run(cmd, capture_output=True, text=True,
                          stdin=subprocess.DEVNULL, check=check)


def human(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


# ------------------------------------------------------------------- rclone
def missing_deps() -> list[str]:
    return [p for p in ("rclone", "fusermount3") if not shutil.which(p)]


def rclone_config_path() -> Path:
    lines = run("rclone", "config", "file").stdout.strip().splitlines()
    return Path(lines[-1].strip())


def remote_exists() -> bool:
    return f"{REMOTE}:" in run("rclone", "listremotes").stdout.split()


def parse_token(output: str) -> dict:
    """Extract the OAuth token from the output of 'rclone authorize'."""
    m = re.search(r"--->\s*(.+?)\s*<---End paste", output, re.S)
    if not m:
        raise RuntimeError(t("err_no_token"))
    blob = m.group(1).strip()
    if not blob.startswith("{"):            # some versions output base64
        blob = base64.urlsafe_b64decode(blob + "=" * (-len(blob) % 4)).decode()
    data = json.loads(blob)
    if isinstance(data.get("token"), str):  # token wrapped in a config blob
        data = json.loads(data["token"])
    if "access_token" not in data:
        raise RuntimeError(t("err_token_format"))
    return data


def fetch_drive(access_token: str) -> tuple[str, str]:
    """Ask Microsoft Graph which drive belongs to this account."""
    req = urllib.request.Request(
        "https://graph.microsoft.com/v1.0/me/drive",
        headers={"Authorization": f"Bearer {access_token}"})
    with urllib.request.urlopen(req, timeout=20) as r:
        drive = json.load(r)
    return drive["id"], drive.get("driveType", "personal")


def write_remote(token: dict, drive_id: str, drive_type: str):
    """Write (or replace) the remote section in rclone.conf."""
    path = rclone_config_path()
    text = path.read_text() if path.exists() else ""
    if "RCLONE_ENCRYPT_V0" in text:
        raise RuntimeError(t("err_encrypted"))
    text = re.sub(rf"(?ms)^\[{re.escape(REMOTE)}\]\n.*?(?=^\[|\Z)", "", text).strip()
    section = (f"[{REMOTE}]\n"
               f"type = onedrive\n"
               f"token = {json.dumps(token, separators=(',', ':'))}\n"
               f"drive_id = {drive_id}\n"
               f"drive_type = {drive_type}\n")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f"{text}\n\n{section}" if text else section)
    path.chmod(0o600)


